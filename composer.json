{
    "name": "smk/scheduling-system",
    "description": "Sistem Penjadwalan Guru SMK Berbasis Algoritma Genetika",
    "type": "project",
    "keywords": [
        "codeigniter",
        "genetic-algorithm",
        "scheduling",
        "php",
        "smk"
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "codeigniter/framework": "^3.1",
        "phpoffice/phpspreadsheet": "^1.29",
        "dompdf/dompdf": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "mikey179/vfsstream": "^1.6",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "application/core/",
            "App\\Libraries\\": "application/libraries/",
            "App\\Models\\": "application/models/",
            "App\\Helpers\\": "application/helpers/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('application/config/database.php') || copy('application/config/database.php.example', 'application/config/database.php');\""
        ],
        "test": "phpunit",
        "lint": "find application -name '*.php' -exec php -l {} \\;"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
